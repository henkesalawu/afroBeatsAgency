/**
 * Universal Text Processor for handling various text formats
 * Handles conversation transcripts, structured reports, lists, and general text
 */

// Detect conversation/transcript format
function detectConversationFormat(text) {
  if (!text || typeof text !== 'string') return null;
  
  const lines = text.split('\n').filter(line => line.trim());
  const conversationPatterns = [
    /^(Agent|Customer|Speaker|Operator|Rep|Client)\s*(\d{2}:\d{2}|\[\d{2}:\d{2}\])?/i,
    /^(A|C|S|O|R):\s*/i, // Short format
  ];
  
  let conversationLines = 0;
  const parsedLines = [];
  
  for (const line of lines.slice(0, Math.min(10, lines.length))) {
    for (const pattern of conversationPatterns) {
      if (pattern.test(line.trim())) {
        conversationLines++;
        break;
      }
    }
  }
  
  // If more than 40% of first lines are conversation format
  if (conversationLines / Math.min(10, lines.length) > 0.4) {
    return parseConversationTranscript(text);
  }
  
  return null;
}

// Parse conversation transcript
function parseConversationTranscript(text) {
  const lines = text.split('\n').filter(line => line.trim());
  const conversationLines = [];
  
  for (const line of lines) {
    const trimmedLine = line.trim();
    if (!trimmedLine) continue;
    
    // Enhanced patterns for different conversation formats
    const patterns = [
      // "Agent 00:02 text" or "Customer 00:10 text"
      /^(Agent|Customer|Speaker|Operator|Rep|Client)\s*(\d{2}:\d{2}|\d+:\d+)?\s*(.+)$/i,
      // "A: text" or "C: text"
      /^([A-Z]):\s*(.+)$/,
      // Special system messages
      /^(Connection|System|Transfer|Queue).*$/i
    ];
    
    let matched = false;
    for (const pattern of patterns) {
      const match = trimmedLine.match(pattern);
      if (match) {
        let speaker, time, text;
        
        if (pattern.source.includes('Agent|Customer')) {
          speaker = match[1];
          time = match[2] || '';
          text = match[3] || '';
        } else if (pattern.source.includes('[A-Z]')) {
          speaker = match[1] === 'A' ? 'Agent' : match[1] === 'C' ? 'Customer' : match[1];
          time = '';
          text = match[2] || '';
        } else {
          speaker = 'System';
          time = '';
          text = trimmedLine;
        }
        
        conversationLines.push({
          speaker: speaker.trim(),
          time: time.replace(/[\[\]]/g, '').trim(),
          text: text.trim()
        });
        matched = true;
        break;
      }
    }
    
    // If no pattern matched, add as continuation of previous line or new system message
    if (!matched && conversationLines.length > 0) {
      const lastLine = conversationLines[conversationLines.length - 1];
      lastLine.text += ' ' + trimmedLine;
    } else if (!matched) {
      conversationLines.push({
        speaker: 'System',
        time: '',
        text: trimmedLine
      });
    }
  }
  
  return conversationLines.length > 2 ? conversationLines : null;
}

// Detect structured assessment format
function detectStructuredAssessment(text) {
  if (!text || typeof text !== 'string') return null;
  
  const structurePatterns = [
    /^Section\s+(One|Two|Three|Four|[IVX]+):/im,
    /^\d+[a-z]?:\s+/m,
    /^[A-Z][^:]*:\s*Score:/im,
    /^⭐{1,3}$/m,
    /^\*{3,}/m,
    /^#{1,6}\s+/m
  ];
  
  for (const pattern of structurePatterns) {
    if (pattern.test(text)) {
      return parseStructuredAssessment(text);
    }
  }
  
  return null;
}

// Parse structured assessment
function parseStructuredAssessment(text) {
  const lines = text.split('\n');
  const blocks = [];
  let currentSection = null;
  let currentParagraph = '';
  
  for (let i = 0; i < lines.length; i++) {
    const line = lines[i].trim();
    
    if (!line) {
      if (currentParagraph) {
        if (currentSection) {
          currentSection.content.push({ type: 'paragraph', text: currentParagraph.trim() });
        } else {
          blocks.push({ type: 'paragraph', text: currentParagraph.trim() });
        }
        currentParagraph = '';
      }
      continue;
    }
    
    // Detect headings
    if (line.match(/^(Section\s+(One|Two|Three|Four|[IVX]+)|#{1,6}|.*:\s*Score:|Overall|Summary|Commentary)/i) ||
        line.match(/^\*{3,}.*\*{3,}$/)) {
      
      // Save current paragraph
      if (currentParagraph) {
        if (currentSection) {
          currentSection.content.push({ type: 'paragraph', text: currentParagraph.trim() });
        } else {
          blocks.push({ type: 'paragraph', text: currentParagraph.trim() });
        }
        currentParagraph = '';
      }
      
      // Save current section
      if (currentSection) {
        blocks.push(currentSection);
      }
      
      // Start new section
      currentSection = {
        type: 'section',
        title: line.replace(/^#+\s*/, '').replace(/\*+/g, ''),
        content: []
      };
    }
    // Detect list items
    else if (line.match(/^\s*[-*•]\s+/) || line.match(/^\s*\d+[.)]\s+/)) {
      if (currentParagraph) {
        if (currentSection) {
          currentSection.content.push({ type: 'paragraph', text: currentParagraph.trim() });
        } else {
          blocks.push({ type: 'paragraph', text: currentParagraph.trim() });
        }
        currentParagraph = '';
      }
      
      const listItem = line.replace(/^\s*[-*•]\s+/, '').replace(/^\s*\d+[.)]\s+/, '');
      const target = currentSection || blocks;
      
      // Check if last item is a list to continue it
      const lastItem = currentSection ? 
        currentSection.content[currentSection.content.length - 1] : 
        blocks[blocks.length - 1];
      
      if (lastItem && lastItem.type === 'list') {
        lastItem.items.push(listItem);
      } else {
        const newList = {
          type: 'list',
          items: [listItem],
          ordered: /^\s*\d+[.)]\s+/.test(line)
        };
        
        if (currentSection) {
          currentSection.content.push(newList);
        } else {
          blocks.push(newList);
        }
      }
    }
    // Regular text
    else {
      currentParagraph += (currentParagraph ? ' ' : '') + line;
    }
  }
  
  // Save remaining content
  if (currentParagraph) {
    if (currentSection) {
      currentSection.content.push({ type: 'paragraph', text: currentParagraph.trim() });
    } else {
      blocks.push({ type: 'paragraph', text: currentParagraph.trim() });
    }
  }
  
  if (currentSection) {
    blocks.push(currentSection);
  }
  
  return blocks.length > 0 ? blocks : null;
}

// Detect and parse tables
function detectTable(text) {
  if (!text || typeof text !== 'string') return null;
  
  const lines = text.split('\n').filter(line => line.trim());
  const tableLines = lines.filter(line => 
    line.includes('|') && 
    line.split('|').length > 2 &&
    !line.match(/^\s*\|*\s*[-\s]*\s*\|*\s*$/) // Skip separator lines
  );
  
  if (tableLines.length < 2) return null;
  
  const headers = tableLines[0].split('|')
    .map(h => h.trim())
    .filter(h => h && !h.match(/^[-\s]*$/));
    
  const rows = [];
  for (let i = 1; i < tableLines.length; i++) {
    const row = tableLines[i].split('|')
      .map(cell => cell.trim())
      .filter(cell => cell && !cell.match(/^[-\s]*$/));
    
    if (row.length > 0) {
      rows.push(row);
    }
  }
  
  return headers.length > 0 && rows.length > 0 ? { headers, rows } : null;
}

// Main text processing function
export function processText(rawText) {
  if (!rawText || typeof rawText !== 'string') {
    return [{ type: 'paragraph', text: 'No content available' }];
  }
  
  const text = rawText.trim();
  
  // Try conversation format first
  const conversation = detectConversationFormat(text);
  if (conversation) {
    return [{ type: 'conversation', lines: conversation }];
  }
  
  // Try structured assessment
  const structuredContent = detectStructuredAssessment(text);
  if (structuredContent) {
    return structuredContent;
  }
  
  // Try table format
  const table = detectTable(text);
  if (table) {
    return [{ type: 'table', headers: table.headers, rows: table.rows }];
  }
  
  // Fallback: process as paragraphs with basic formatting
  return processPlainText(text);
}

// Process plain text with basic formatting
function processPlainText(text) {
  const blocks = [];
  const paragraphs = text.split(/\n\s*\n/).filter(p => p.trim());
  
  for (const paragraph of paragraphs) {
    const trimmed = paragraph.trim();
    
    // Check for heading patterns
    if (trimmed.split('\n').length === 1 && (
      trimmed.match(/^[A-Z][^.!?]*:$/) ||
      trimmed.match(/^#{1,6}\s+/) ||
      trimmed.length < 100 && trimmed.match(/^[A-Z][A-Z\s]{2,}$/)
    )) {
      blocks.push({
        type: 'heading',
        text: trimmed.replace(/^#+\s*/, '').replace(/:$/, ''),
        level: trimmed.match(/^#+/) ? trimmed.match(/^#+/)[0].length : 3
      });
      continue;
    }
    
    // Check for list
    const lines = trimmed.split('\n').map(l => l.trim()).filter(l => l);
    if (lines.length > 1 && lines.every(line => 
      line.match(/^\s*[-*•]\s+/) || line.match(/^\s*\d+[.)]\s+/)
    )) {
      const items = lines.map(line => 
        line.replace(/^\s*[-*•]\s+/, '').replace(/^\s*\d+[.)]\s+/, '')
      );
      blocks.push({
        type: 'list',
        items,
        ordered: lines[0].match(/^\s*\d+[.)]\s+/) !== null
      });
      continue;
    }
    
    // Regular paragraph
    blocks.push({
      type: 'paragraph',
      text: trimmed
    });
  }
  
  return blocks.length > 0 ? blocks : [{ type: 'paragraph', text: text }];
}

// React component for rendering processed text
import React from 'react';

export const TextRenderer = ({ rawText, className = '', maxLength = null }) => {
  if (!rawText) {
    return <div className={`text-muted ${className}`}>No content available</div>;
  }
  
  const blocks = processText(rawText);
  
  return (
    <div className={`text-processor ${className}`}>
      {blocks.map((block, idx) => {
        switch (block.type) {
          case 'conversation':
            return (
              <div key={idx} className="conversation-transcript">
                {block.lines.map((line, i) => (
                  <div key={i} className="conversation-line">
                    <span className="speaker">{line.speaker}</span>
                    {line.time && (
                      <span className="timestamp">[{line.time}]</span>
                    )}
                    <span className="message">{line.text}</span>
                  </div>
                ))}
              </div>
            );
            
          case 'section':
            return (
              <div key={idx} className="assessment-section">
                <h4 className="section-title">{block.title}</h4>
                <div className="section-content">
                  {block.content.map((item, i) => (
                    <TextRenderer key={i} rawText="" blocks={[item]} />
                  ))}
                </div>
              </div>
            );
            
          case 'heading':
            const HeadingTag = `h${Math.min(block.level || 3, 6)}`;
            return (
              <HeadingTag key={idx} className="text-heading">
                {block.text}
              </HeadingTag>
            );
            
          case 'paragraph':
            const text = maxLength && block.text.length > maxLength 
              ? block.text.substring(0, maxLength) + '...' 
              : block.text;
            return (
              <p key={idx} className="text-paragraph">
                {text}
              </p>
            );
            
          case 'list':
            const ListTag = block.ordered ? 'ol' : 'ul';
            return (
              <ListTag key={idx} className="text-list">
                {block.items.map((item, i) => (
                  <li key={i}>{item}</li>
                ))}
              </ListTag>
            );
            
          case 'table':
            return (
              <div key={idx} className="table-container">
                <table className="text-table">
                  <thead>
                    <tr>
                      {block.headers.map((header, i) => (
                        <th key={i}>{header}</th>
                      ))}
                    </tr>
                  </thead>
                  <tbody>
                    {block.rows.map((row, i) => (
                      <tr key={i}>
                        {row.map((cell, j) => (
                          <td key={j}>{cell}</td>
                        ))}
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            );
            
          default:
            return null;
        }
      })}
    </div>
  );
};

export default TextRenderer;

