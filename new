// Convert processed text blocks to PDF content
function convertTextBlocksToPDF(rawText, maxWidth = 500) {
  if (!rawText) return [{ text: 'No content available', style: 'small', color: '#999' }];
  
  const blocks = processText(rawText);
  const content = [];
  
  blocks.forEach((block, blockIndex) => {
    switch (block.type) {
      case 'conversation':
        content.push({ text: 'Conversation Transcript:', style: 'label' });
        
        // Group conversation lines to avoid orphaned lines
        const conversationContent = [];
        block.lines.forEach((line, index) => {
          const lineText = `${line.speaker}${line.time ? ` [${line.time}]` : ''}: ${line.text}`;
          
          conversationContent.push({
            text: lineText,
            style: 'conversation',
            margin: [10, 2, 0, 2]
          });
          
          // Add small gap every 5 lines for readability
          if ((index + 1) % 5 === 0 && index < block.lines.length - 1) {
            conversationContent.push({ text: '', margin: [0, 3, 0, 3] });
          }
        });
        
        content.push({
          stack: conversationContent,
          margin: [0, 5, 0, 15],
          background: '#f9f9f9',
          border: [true, true, true, true],
          borderColor: '#ddd'
        });
        break;
        
      case 'section':
        content.push({
          text: block.title,
          style: 'subHeader',
          pageBreak: blockIndex > 0 ? 'before' : undefined
        });
        
        // Process section content recursively
        block.content.forEach(item => {
          const sectionContent = convertTextBlocksToPDF('', maxWidth);
          // Process each content item based on its type
          switch (item.type) {
            case 'paragraph':
              content.push({ text: item.text, style: 'normal' });
              break;
            case 'list':
              const listContent = item.items.map(listItem => ({ text: listItem, style: 'normal' }));
              if (item.ordered) {
                content.push({ ol: listContent, margin: [0, 5, 0, 10] });
              } else {
                content.push({ ul: listContent, margin: [0, 5, 0, 10] });
              }
              break;
            default:
              content.push({ text: item.text || '', style: 'normal' });
          }
        });
        break;
        
      case 'heading':
        const headingStyle = block.level <= 2 ? 'subHeader' : 'label';
        content.push({
          text: block.text,
          style: headingStyle,
          pageBreak: blockIndex > 0 && block.level <= 2 ? 'before' : undefined
        });
        break;
        
      case 'paragraph':
        // Handle very long paragraphs by splitting them
        if (block.text.length > 1200) {
          const sentences = block.text.split(/(?<=[.!?])\s+/);
          let currentParagraph = '';
          
          sentences.forEach(sentence => {
            if (currentParagraph.length + sentence.length > 800) {
              if (currentParagraph) {
                content.push({ text: currentParagraph.trim(), style: 'normal' });
                currentParagraph = sentence;
              }
            } else {
              currentParagraph += (currentParagraph ? ' ' : '') + sentence;
            }
          });
          
          if (currentParagraph) {
            content.push({ text: currentParagraph.trim(), style: 'normal' });
          }
        } else {
          content.push({ text: block.text, style: 'normal' });
        }
        break;
        
      case 'list':
        const listItems = block.items.map(item => ({ text: item, style: 'normal' }));
        if (block.ordered) {
          content.push({ ol: listItems, margin: [0, 5, 0, 10] });
        } else {
          content.push({ ul: listItems, margin: [0, 5, 0, 10] });
        }
        break;
        
      case 'table':
        if (block.headers && block.rows) {
          const tableBody = [
            block.headers.map(header => ({ text: header, style: 'tableHeader' }))
          ];
          
          block.rows.forEach(row => {
            tableBody.push(
              row.map(cell => ({
                text: cell.length > 150 ? cell.substring(0, 150) + '...' : cell,
                style: 'tableCell'
              }))
            );
          });
          
          content.push({
            table: {
              headerRows: 1,
              body: tableBody,
              widths: Array(block.headers.length).fill('*')
            },
            layout: {
              fillColor: function (rowIndex) {
                return rowIndex === 0 ? '#5A287D' : (rowIndex % 2 === 0 ? '#f9f9f9' : null);
              },
              hLineColor: function () { return '#ddd'; },
              vLineColor: function () { return '#ddd'; }
            },
            margin: [0, 10, 0, 15]
          });
        }
        break;
        
      default:
        break;
    }
  });
  
  return content.length > 0 ? content : [{ text: 'No content available', style: 'small', color: '#999' }];
}

// Format date for display
function formatDate(dateString) {
  if (!dateString) return 'N/A';
  try {
    return new Date(dateString).toLocaleString('en-GB', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
      hour: '2-digit',
      minute: '2-digit'
    });
  } catch {
    return dateString;
  }
}

// Create metrics table for PDF
function createMetricsTable(metrics, title) {
  if (!metrics || metrics.length === 0) {
    return [];
  }
  
  const content = [];
  
  if (title) {
    content.push({ text: title, style: 'subHeader' });
  }
  
  const tableBody = [
    [
      { text: 'Metric Name', style: 'tableHeader' },
      { text: 'Score', style: 'tableHeader' },
      { text: 'Status', style: 'tableHeader' },
      { text: 'Reason', style: 'tableHeader' }
    ]
  ];
  
  metrics.forEach(metric => {
    const reason = metric.reason || 'No reason provided';
    const truncatedReason = reason.length > 300 ? reason.substring(0, 300) + '...' : reason;
    
    tableBody.push([
      { text: metric.name || 'N/A', style: 'tableCell' },
      { 
        text: typeof metric.score === 'number' ? `${(metric.score * 100).toFixed(1)}%` : 'N/A', 
        style: 'tableCell',
        alignment: 'center'
      },
      { 
        text: metric.status || 'N/A', 
        style: 'tableCell',
        alignment: 'center'
      },
      { text: truncatedReason, style: 'tableCell' }
    ]);
  });
  
  content.push({
    table: {
      headerRows: 1,
      body: tableBody,
      widths: ['25%', '10%', '10%', '55%']
    },
    layout: {
      fillColor: function (rowIndex) {
        return rowIndex === 0 ? '#5A287D' : (rowIndex % 2 === 0 ? '#f9f9f9' : null);
      },
      hLineColor: function () { return '#ddd'; },
      vLineColor: function () { return '#ddd'; }
    },
    margin: [0, 10, 0, 20]
  });
  
  return content;
}

// Main PDF generation function
export function generatePDFDocument(execution, logoBase64 = null) {
  if (!execution) {
    return {
      content: [{ text: 'No execution data available', style: 'title' }],
      styles: pdfStyles
    };
  }
  
  const content = [];
  
  // Header with logo and title
  if (logoBase64) {
    content.push({
      columns: [
        { text: 'Execution Test Report', style: 'title', width: '*' },
        { image: logoBase64, width: 60, height: 60, alignment: 'right' }
      ],
      margin: [0, 0, 0, 30]
    });
  } else {
    content.push({ text: 'Execution Test Report', style: 'title' });
  }
  
  // Basic Execution Information Section
  content.push({ text: 'Execution Information', style: 'sectionHeader' });
  
  const executionInfo = [
    ['Execution ID', execution.execution_id || 'N/A'],
    ['Status', execution.status || 'N/A'],
    ['Executed By', execution.executed_by || 'N/A'],
    ['Model', execution.model || 'N/A'],
    ['Started At', formatDate(execution.started_at)],
    ['Finished At', formatDate(execution.finished_at)],
    ['Aidlet ID', execution.aidlet_id || 'N/A'],
    ['Dataset Type', execution.execution_config?.dataset_type || 'N/A']
  ];
  
  // Create execution info table
  const executionTableBody = [
    [
      { text: 'Property', style: 'tableHeader' },
      { text: 'Value', style: 'tableHeader' }
    ]
  ];
  
  executionInfo.forEach(([property, value]) => {
    executionTableBody.push([
      { text: property, style: 'tableCell', bold: true },
      { text: value, style: 'tableCell' }
    ]);
  });
  
  content.push({
    table: {
      headerRows: 1,
      body: executionTableBody,
      widths: ['30%', '70%']
    },
    layout: {
      fillColor: function (rowIndex) {
        return rowIndex === 0 ? '#5A287D' : (rowIndex % 2 === 0 ? '#f9f9f9' : null);
      },
      hLineColor: function () { return '#ddd'; },
      vLineColor: function () { return '#ddd'; }
    },
    margin: [0, 0, 0, 20]
  });
  
  // Results Section
  if (execution.results && execution.results.length > 0) {
    content.push({ 
      text: 'Test Results', 
      style: 'sectionHeader',
      pageBreak: 'before'
    });
    
    execution.results.forEach((result, index) => {
      // Result header
      content.push({
        text: `Result ${index + 1} - Status: ${result.status || 'N/A'}`,
        style: 'subHeader',
        pageBreak: index > 0 ? 'before' : undefined
      });
      
      // Result reason
      if (result.final_reason) {
        content.push({ text: 'Final Reason:', style: 'label' });
        content.push(...convertTextBlocksToPDF(result.final_reason));
      }
      
      // Prompt text
      if (result.prompt_text) {
        content.push({ text: 'Prompt Text:', style: 'label' });
        content.push(...convertTextBlocksToPDF(result.prompt_text));
      }
      
      // Expected response
      if (result.ideal_response) {
        content.push({ text: 'Expected Response:', style: 'label' });
        content.push(...convertTextBlocksToPDF(result.ideal_response));
      }
      
      // Actual response
      if (result.actual_response) {
        content.push({ text: 'Actual Response:', style: 'label' });
        content.push(...convertTextBlocksToPDF(result.actual_response));
      }
      
      // Result metrics
      if (result.metrics && result.metrics.length > 0) {
        content.push(...createMetricsTable(result.metrics, 'Result Metrics'));
      }
      
      // Add spacing between results
      if (index < execution.results.length - 1) {
        content.push({ text: '', margin: [0, 0, 0, 20] });
      }
    });
  }
  
  // Overall Execution Metrics
  if (execution.metrics && execution.metrics.length > 0) {
    content.push({ 
      text: 'Overall Execution Metrics', 
      style: 'sectionHeader',
      pageBreak: 'before'
    });
    content.push(...createMetricsTable(execution.metrics, null));
  }
  
  // PDF document definition
  const docDefinition = {
    content,
    styles: pdfStyles,
    pageSize: 'A4',
    pageMargins: [40, 60, 40, 60],
    footer: function(currentPage, pageCount) {
      return {
        text: `Generated by Aidlet Testing Framework | Execution ID: ${execution.execution_id || 'N/A'} | Page ${currentPage} of ${pageCount}`,
        style: 'footer',
        margin: [40, 20, 40, 0]
      };
    },
    defaultStyle: {
      font: 'Helvetica'
    },
    info: {
      title: `Execution Report - ${execution.execution_id}`,
      author: 'Aidlet Testing Framework',
      subject: `Test execution results for ${execution.execution_id}`,
      creator: 'Aidlet Testing Framework'
    }
  };
  
  return docDefinition;
}

// Generate and download PDF
export function generateAndDownloadPDF(execution, logoBase64 = null, filename = null) {
  try {
    const docDefinition = generatePDFDocument(execution, logoBase64);
    const finalFilename = filename || `execution_report_${execution.execution_id}_${new Date().getTime()}.pdf`;
    
    pdfMake.createPdf(docDefinition).download(finalFilename);
    return true;
  } catch (error) {
    console.error('Error generating PDF:', error);
    throw new Error('Failed to generate PDF report: ' + error.message);
  }
}


