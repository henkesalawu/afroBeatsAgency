import { marked } from 'marked';
import htmlToPdfmake from 'html-to-pdfmake';

/** Inserts zero-width spaces into long strings for wrapping */
function insertZeroWidthSpaces(text, maxLength = 20) {
  if (!text) return '';
  const regex = new RegExp(`(.{${maxLength}})`, 'g');
  return text.replace(regex, '$1\u200B');
}

/** Formats date string to readable format */
function formatDateTime(dateString) {
  if (!dateString) return 'N/A';
  try {
    const date = new Date(dateString);
    return date.toLocaleString('en-GB', {
      year: 'numeric',
      month: 'short',
      day: 'numeric',
      hour: '2-digit',
      minute: '2-digit',
      second: '2-digit'
    });
  } catch {
    return dateString;
  }
}

/** Detects if text is a conversation transcript */
function isConversationFormat(text) {
  if (!text) return false;
  // Look for patterns like "Agent 00:02" or "Customer 00:10"
  const conversationPattern = /^(Agent|Customer|User|Assistant|AI|Human)\s+\d+:\d+/m;
  return conversationPattern.test(text);
}

/** Formats conversation transcript for better readability */
function formatConversation(text) {
  if (!text) return [{ text: 'No content', style: 'responseText' }];
  
  const lines = text.split('\n');
  const formattedLines = [];
  
  for (let line of lines) {
    line = line.trim();
    if (!line) continue;
    
    // Check if line starts with participant and timestamp
    const match = line.match(/^(Agent|Customer|User|Assistant|AI|Human)\s+(\d+:\d+)\s*(.*)$/);
    if (match) {
      const [, participant, timestamp, message] = match;
      formattedLines.push({
        margin: [0, 3, 0, 0],
        stack: [
          {
            text: `${participant} (${timestamp})`,
            style: 'conversationSpeaker',
            bold: true
          },
          {
            text: message || '',
            style: 'conversationMessage',
            margin: [10, 2, 0, 0]
          }
        ]
      });
    } else {
      // Continuation of previous message or metadata
      if (formattedLines.length > 0) {
        // Add to last message
        formattedLines[formattedLines.length - 1].stack.push({
          text: line,
          style: 'conversationMessage',
          margin: [10, 1, 0, 0]
        });
      } else {
        // Metadata or header
        formattedLines.push({
          text: line,
          style: 'conversationMeta',
          margin: [0, 2, 0, 2]
        });
      }
    }
  }
  
  return formattedLines;
}

/** Detects if text is a structured assessment */
function isAssessmentFormat(text) {
  if (!text) return false;
  // Look for patterns like "Score:" or "Assessment" or structured ratings
  const assessmentPattern = /(score|assessment|rating|evaluation).*[:\-]/i;
  const scorePattern = /\d+[\./]\d+/; // patterns like 9.2/10 or 85%
  return assessmentPattern.test(text) || scorePattern.test(text);
}

/** Formats assessment text with proper structure */
function formatAssessment(text) {
  if (!text) return [{ text: 'No content', style: 'responseText' }];
  
  const lines = text.split('\n').map(line => line.trim()).filter(line => line);
  const formattedLines = [];
  
  for (const line of lines) {
    // Check for headers (# markdown or ALL CAPS lines)
    if (line.startsWith('#') || (line === line.toUpperCase() && line.length > 5)) {
      formattedLines.push({
        text: line.replace(/^#+\s*/, ''),
        style: 'assessmentHeader',
        margin: [0, 8, 0, 4]
      });
    }
    // Check for score lines (containing numbers and colons)
    else if (line.includes(':') && /\d/.test(line)) {
      const [key, ...valueParts] = line.split(':');
      const value = valueParts.join(':').trim();
      
      formattedLines.push({
        columns: [
          { text: key.trim() + ':', width: 'auto', style: 'assessmentKey' },
          { text: value, width: '*', style: 'assessmentValue', margin: [10, 0, 0, 0] }
        ],
        margin: [0, 2, 0, 2]
      });
    }
    // Bullet points or dashes
    else if (line.startsWith('-') || line.startsWith('•') || line.startsWith('*')) {
      formattedLines.push({
        text: line.substring(1).trim(),
        style: 'assessmentBullet',
        margin: [15, 1, 0, 1]
      });
    }
    // Regular paragraphs
    else {
      formattedLines.push({
        text: line,
        style: 'assessmentText',
        margin: [0, 3, 0, 3]
      });
    }
  }
  
  return formattedLines;
}

/**
 * Tries to parse text as key-value pairs.
 * Returns array of {key, value} if >= threshold ratio of lines match, else null.
 */
function tryParseKeyValueText(text, threshold = 0.7) {
  if (!text) return null;
  const lines = text
    .split('\n')
    .map(line => line.trim())
    .filter(line => line.length > 0);

  const kvRegex = /^([\w\d_]+)\s+(.+)$/; // key value

  const kvPairs = [];
  let matchedLines = 0;

  for (const line of lines) {
    const match = line.match(kvRegex);
    if (match) {
      matchedLines++;
      kvPairs.push({ key: match[1], value: match[2] });
    } else {
      // Non-matching lines are appended to last pair's value (continuation)
      if (kvPairs.length) {
        kvPairs[kvPairs.length - 1].value += ' ' + line;
      } else {
        // No valid pairs at start: treat as unstructured
        return null;
      }
    }
  }

  if (lines.length === 0) return null;
  if (matchedLines / lines.length >= threshold) {
    return kvPairs;
  }
  return null;
}

/** Converts parsed key-value pairs to a pdfMake table */
function keyValuePairsToPdfMakeTable(pairs) {
  if (!pairs?.length) return [];

  const body = [
    [
      { text: 'Key', style: 'tableHeader' },
      { text: 'Value', style: 'tableHeader' },
    ],
    ...pairs.map(({ key, value }) => [
      { text: insertZeroWidthSpaces(key), style: 'kvKey' },
      { text: insertZeroWidthSpaces(value), style: 'kvValue' },
    ]),
  ];

  return [
    {
      style: 'kvTable',
      table: {
        headerRows: 1,
        widths: ['auto', '*'],
        body,
      },
      layout: 'lightHorizontalLines',
      margin: [0, 5, 0, 15],
    },
  ];
}

/** Converts markdown string to pdfMake content with zero-width space insertion */
const markdownToPdfMakeContent = (markdown) => {
  try {
    const processedMarkdown = insertZeroWidthSpaces(markdown || '', 20);
    const html = marked(processedMarkdown);
    const pdfmakeContent = htmlToPdfmake(html, { window: window });
    return Array.isArray(pdfmakeContent) ? pdfmakeContent : [pdfmakeContent];
  } catch (error) {
    console.error('Error converting markdown to pdfMake content:', error);
    return [
      { text: insertZeroWidthSpaces(markdown || '', 20), style: 'responseText' },
    ];
  }
};

/**
 * Tries to parse the text as JSON and returns pretty-printed string.
 * Returns null if not valid JSON.
 */
function tryParseAndPrettyPrintJSON(text) {
  if (!text) return null;
  try {
    const obj = JSON.parse(text);
    // Pretty print JSON with 2 spaces indentation
    return JSON.stringify(obj, null, 2);
  } catch {
    return null;
  }
}

/**
 * Enhanced text formatter with intelligent content detection
 * - Detects conversations → formatted dialogue
 * - Detects assessments → structured evaluation format  
 * - Detects JSON → pretty print in monospace style
 * - Uses key-value table if detected (unless skipKeyValue is true)
 * - Otherwise renders markdown content
 */
function formatTextForPdf(text, options = {}) {
  const { skipKeyValue = false, maxLength = null } = options;
  
  if (!text || text.trim() === '') {
    return [{ text: 'No content available', style: 'noContent', italics: true }];
  }

  // Truncate if needed
  let processedText = text;
  if (maxLength && text.length > maxLength) {
    processedText = text.substring(0, maxLength) + '...';
  }

  // 1. Try conversation format first
  if (isConversationFormat(processedText)) {
    return formatConversation(processedText);
  }

  // 2. Try assessment format
  if (isAssessmentFormat(processedText)) {
    return formatAssessment(processedText);
  }

  // 3. Try JSON format
  const jsonPretty = tryParseAndPrettyPrintJSON(processedText);
  if (jsonPretty) {
    const wrappedJson = insertZeroWidthSpaces(jsonPretty, 30);
    return [
      {
        text: wrappedJson,
        style: 'codeBlock',
      },
    ];
  }

  // 4. Try key-value pairs (unless skipped)
  if (!skipKeyValue) {
    const parsedPairs = tryParseKeyValueText(processedText);
    if (parsedPairs) {
      return keyValuePairsToPdfMakeTable(parsedPairs);
    }
  }

  // 5. Handle as markdown/plain text
  try {
    return markdownToPdfMakeContent(processedText);
  } catch (error) {
    // Fallback to plain text with proper wrapping
    return [
      {
        text: insertZeroWidthSpaces(processedText, 40),
        style: 'responseText'
      }
    ];
  }
}

/**
 * Main function to generate pdfMake document definition from execution data.
 */
export function generatePDFDocument(execution) {
  const content = [];

  // Header
  content.push({ text: 'Execution Report', style: 'header' });
  content.push({ 
    text: `Generated on ${formatDateTime(new Date().toISOString())}`, 
    style: 'subtitle',
    margin: [0, 0, 0, 20] 
  });

  // 1. BASIC EXECUTION INFO SECTION
  content.push({ text: 'Execution Details', style: 'sectionHeader' });
  
  const execInfoBody = [
    ['Field', 'Value'].map((txt) => ({ text: txt, style: 'tableHeader' })),
    ['Execution ID', execution.execution_id || 'N/A'],
    ['Status', execution.status || 'N/A'],
    ['Executed By', execution.executed_by || 'N/A'],
    ['Model', execution.model || 'N/A'],
    ['Aidlet ID', execution.aidlet_id || 'N/A'],
    ['Started At', formatDateTime(execution.started_at)],
    ['Finished At', formatDateTime(execution.finished_at)],
  ];

  // Add execution config details
  if (execution.execution_config) {
    const config = execution.execution_config;
    if (config.browser) execInfoBody.push(['Browser', config.browser]);
    if (config.headless !== undefined) execInfoBody.push(['Headless Mode', config.headless ? 'Yes' : 'No']);
    if (config.environment) execInfoBody.push(['Environment', config.environment]);
    if (config.num_prompts) execInfoBody.push(['Number of Prompts', config.num_prompts.toString()]);
    if (config.dataset_type) execInfoBody.push(['Dataset Type', config.dataset_type]);
  }

  content.push({
    style: 'detailsTable',
    table: {
      widths: ['auto', '*'],
      body: execInfoBody,
    },
    layout: 'lightHorizontalLines',
    margin: [0, 0, 0, 25],
  });

  // 2. RESULTS SECTION
  content.push({ text: 'Test Results', style: 'sectionHeader', margin: [0, 20, 0, 10] });

  if (!execution.results || execution.results.length === 0) {
    content.push({ 
      text: 'No results available for this execution.', 
      italics: true, 
      style: 'noContent',
      margin: [0, 0, 0, 15] 
    });
  } else {
    execution.results.forEach((result, idx) => {
      // Result header
      content.push({ 
        text: `Test Result ${idx + 1}`, 
        style: 'resultHeader', 
        margin: [0, 15, 0, 10] 
      });

      // Status
      content.push({
        text: [
          { text: 'Status: ', style: 'fieldLabel' },
          { text: result.status || 'N/A', style: result.status === 'PASS' ? 'statusPass' : 'statusFail' }
        ],
        margin: [0, 0, 0, 8]
      });

      // Final Reason
      if (result.final_reason) {
        content.push({ 
          text: 'Reason:', 
          style: 'fieldLabel', 
          margin: [0, 8, 0, 4] 
        });
        content.push({ 
          stack: formatTextForPdf(result.final_reason, { maxLength: 2000 }), 
          margin: [0, 0, 0, 10]
        });
      }

      // Prompt Text
      if (result.prompt_text) {
        content.push({ 
          text: 'Prompt Text:', 
          style: 'fieldLabel', 
          margin: [0, 8, 0, 4] 
        });
        content.push({ 
          stack: formatTextForPdf(result.prompt_text, { skipKeyValue: true, maxLength: 3000 }), 
          margin: [0, 0, 0, 10]
        });
      }

      // Ideal Response
      if (result.ideal_response) {
        content.push({ 
          text: 'Expected Response:', 
          style: 'fieldLabel', 
          margin: [0, 8, 0, 4] 
        });
        content.push({ 
          stack: formatTextForPdf(result.ideal_response, { maxLength: 2000 }), 
          margin: [0, 0, 0, 10]
        });
      }

      // Actual Response
      if (result.actual_response) {
        content.push({ 
          text: 'Actual Response:', 
          style: 'fieldLabel', 
          margin: [0, 8, 0, 4] 
        });
        content.push({ 
          stack: formatTextForPdf(result.actual_response, { maxLength: 2000 }), 
          margin: [0, 0, 0, 10]
        });
      }

      // Metrics Table
      if (result.metrics && result.metrics.length > 0) {
        content.push({ 
          text: 'Test Metrics:', 
          style: 'fieldLabel', 
          margin: [0, 12, 0, 6] 
        });

        const metricTableBody = [
          ['Metric', 'Score', 'Status', 'Reason'].map((header) => ({
            text: header,
            style: 'tableHeader',
          })),
          ...result.metrics.map((metric) => [
            metric.name || 'Unknown',
            `${(metric.score * 100).toFixed(1)}%`,
            { 
              text: metric.status || 'N/A', 
              style: metric.status === 'PASS' ? 'statusPass' : 'statusFail' 
            },
            { 
              text: insertZeroWidthSpaces(metric.reason || '', 30), 
              fontSize: 9 
            }
          ]),
        ];

        content.push({
          table: {
            headerRows: 1,
            widths: ['*', 'auto', 'auto', '*'],
            body: metricTableBody,
          },
          layout: {
            fillColor: (rowIndex) => (rowIndex % 2 === 0 ? '#f9f9f9' : null),
            hLineWidth: () => 0.5,
            vLineWidth: () => 0.5,
            hLineColor: () => '#cccccc',
            vLineColor: () => '#cccccc'
          },
          margin: [0, 0, 0, 15],
        });
      }

      // Page break between results except the last
      if (idx < execution.results.length - 1) {
        content.push({ text: '', pageBreak: 'after' });
      }
    });
  }

  // 3. OVERALL EXECUTION METRICS SECTION
  content.push({
    text: 'Overall Execution Metrics',
    style: 'sectionHeader',
    margin: [0, 25, 0, 10],
  });

  if (execution.metrics && execution.metrics.length > 0) {
    const overallMetricTableBody = [
      ['Metric', 'Score', 'Status', 'Reason'].map((header) => ({
        text: header,
        style: 'tableHeader',
      })),
      ...execution.metrics.map((metric) => [
        metric.name || 'Unknown Metric',
        `${(metric.score * 100).toFixed(1)}%`,
        { 
          text: metric.status || 'N/A', 
          style: metric.status === 'PASS' ? 'statusPass' : 'statusFail' 
        },
        { 
          text: insertZeroWidthSpaces(metric.reason || '', 30), 
          fontSize: 9 
        }
      ]),
    ];

    content.push({
      table: {
        headerRows: 1,
        widths: ['*', 'auto', 'auto', '*'],
        body: overallMetricTableBody,
      },
      layout: {
        fillColor: (rowIndex) => (rowIndex % 2 === 0 ? '#f9f9f9' : null),
        hLineWidth: () => 0.5,
        vLineWidth: () => 0.5,
        hLineColor: () => '#cccccc',
        vLineColor: () => '#cccccc'
      },
      margin: [0, 0, 0, 20],
    });
  } else {
    content.push({ 
      text: 'No overall execution metrics available for this test run.', 
      italics: true, 
      style: 'noContent',
      margin: [0, 0, 0, 20]
    });
  }

  // Document definition with enhanced styles
  const docDefinition = {
    content,
    styles: {
      // Main headers
      header: { fontSize: 24, bold: true, color: '#42145F', margin: [0, 0, 0, 5] },
      subtitle: { fontSize: 12, color: '#666666', italics: true },
      sectionHeader: { fontSize: 18, bold: true, color: '#5A287D', margin: [0, 15, 0, 8] },
      resultHeader: { fontSize: 14, bold: true, color: '#5E10B1', margin: [0, 10, 0, 5] },
      
      // Field labels and content
      fieldLabel: { fontSize: 12, bold: true, color: '#42145F', margin: [0, 0, 0, 2] },
      responseText: { fontSize: 11, margin: [0, 0, 0, 5], color: '#333333', lineHeight: 1.4 },
      noContent: { fontSize: 11, color: '#888888', italics: true },
      
      // Status indicators
      statusPass: { color: '#16a085', bold: true },
      statusFail: { color: '#e74c3c', bold: true },
      
      // Table styling
      tableHeader: { bold: true, fillColor: '#5A287D', color: '#ffffff', margin: [4, 6, 4, 6] },
      detailsTable: { margin: [0, 0, 0, 15], fontSize: 11, color: '#42145F' },
      
      // Conversation formatting
      conversationSpeaker: { fontSize: 11, color: '#5A287D', bold: true },
      conversationMessage: { fontSize: 11, color: '#333333', lineHeight: 1.3 },
      conversationMeta: { fontSize: 10, color: '#666666', italics: true },
      
      // Assessment formatting
      assessmentHeader: { fontSize: 13, bold: true, color: '#5E10B1' },
      assessmentKey: { fontSize: 11, bold: true, color: '#42145F' },
      assessmentValue: { fontSize: 11, color: '#333333' },
      assessmentBullet: { fontSize: 11, color: '#333333', margin: [0, 1, 0, 1] },
      assessmentText: { fontSize: 11, color: '#333333', lineHeight: 1.3 },
      
      // Code and technical content
      codeBlock: {
        fontSize: 10,
        fontFamily: 'Courier',
        background: '#f8f9fa',
        margin: [0, 5, 0, 10],
        padding: 8,
        color: '#333333',
        preserveLeadingSpaces: true,
      },
      
      // Standard text elements
      paragraph: { margin: [0, 3, 0, 3], fontSize: 11, color: '#333333', lineHeight: 1.3 },
      strong: { bold: true, color: '#42145F' },
      em: { italics: true, color: '#5A287D' },
      
      // Key-value table styles
      kvTable: { margin: [0, 5, 0, 10], fontSize: 11 },
      kvKey: { bold: true, color: '#42145F', margin: [4, 3, 4, 3] },
      kvValue: { margin: [4, 3, 4, 3], color: '#333333' },
    },
    defaultStyle: {
      font: 'Helvetica',
      fontSize: 11,
      lineHeight: 1.3,
      color: '#333333',
    },
    pageMargins: [50, 60, 50, 60],
    pageSize: 'A4',
    info: {
      title: `Execution Report - ${execution.execution_id || 'Unknown'}`,
      author: execution.executed_by || 'Test System',
      subject: 'Test Execution Results',
      creator: 'PDF Generator',
      producer: 'Test Results System'
    }
  };

  return docDefinition;
}

/**
 * Generates and downloads PDF document
 */
export function downloadPDF(execution, filename = null) {
  const docDefinition = generatePDFDocument(execution);
  const pdfName = filename || `execution-${execution.execution_id || Date.now()}.pdf`;
  
  // Use pdfMake to create and download
  if (typeof window !== 'undefined' && window.pdfMake) {
    window.pdfMake.createPdf(docDefinition).download(pdfName);
  } else {
    console.error('pdfMake not available in window object');
  }
}

import React, { useState } from 'react';
import { generatePDFDocument, downloadPDF } from './edit.js';

/**
 * PDF Download Button Component
 * Handles PDF generation and download with loading states and error handling
 */
const PDFDownloadButton = ({ 
  executionData, 
  filename = null, 
  buttonText = "Download PDF",
  className = "",
  disabled = false 
}) => {
  const [isGenerating, setIsGenerating] = useState(false);
  const [error, setError] = useState(null);

  const handleDownload = async () => {
    if (!executionData) {
      setError('No execution data available');
      return;
    }

    setIsGenerating(true);
    setError(null);

    try {
      // Generate and download PDF
      await downloadPDF(executionData, filename);
      
      // Clear any previous errors
      setError(null);
    } catch (err) {
      console.error('PDF generation failed:', err);
      setError('Failed to generate PDF. Please try again.');
    } finally {
      setIsGenerating(false);
    }
  };

  return (
    <div className="pdf-download-container">
      <button
        onClick={handleDownload}
        disabled={disabled || isGenerating || !executionData}
        className={`pdf-download-btn ${className} ${isGenerating ? 'generating' : ''}`}
        style={{
          padding: '10px 20px',
          backgroundColor: isGenerating ? '#cccccc' : '#5A287D',
          color: 'white',
          border: 'none',
          borderRadius: '6px',
          cursor: isGenerating || disabled || !executionData ? 'not-allowed' : 'pointer',
          fontSize: '14px',
          fontWeight: '600',
          display: 'flex',
          alignItems: 'center',
          gap: '8px',
          transition: 'all 0.2s ease',
          opacity: disabled || !executionData ? 0.6 : 1
        }}
      >
        {isGenerating ? (
          <>
            <span className="spinner" style={{
              width: '14px',
              height: '14px',
              border: '2px solid transparent',
              borderTop: '2px solid white',
              borderRadius: '50%',
              animation: 'spin 1s linear infinite'
            }}></span>
            Generating...
          </>
        ) : (
          <>
            📄 {buttonText}
          </>
        )}
      </button>

      {error && (
        <div className="error-message" style={{
          marginTop: '8px',
          padding: '8px 12px',
          backgroundColor: '#fee',
          color: '#c33',
          borderRadius: '4px',
          fontSize: '12px',
          border: '1px solid #fcc'
        }}>
          {error}
        </div>
      )}

      <style jsx>{`
        @keyframes spin {
          0% { transform: rotate(0deg); }
          100% { transform: rotate(360deg); }
        }
        
        .pdf-download-btn:hover:not(:disabled) {
          background-color: #4A1F6B !important;
          transform: translateY(-1px);
          box-shadow: 0 4px 8px rgba(90, 40, 125, 0.3);
        }
        
        .pdf-download-btn:active:not(:disabled) {
          transform: translateY(0);
        }
      `}</style>
    </div>
  );
};

export default PDFDownloadButton;



