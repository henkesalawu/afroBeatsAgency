import React, { useState, useCallback, useMemo } from 'react';
import { useSelector } from 'react-redux';
import TextRenderer from './TextProcessor';
import PDFGenerator from './PDFGenerator';
import EnhancedComparisonResponses from './EnhancedComparisonResponses';
import './EnhancedSplitView.css';

/**
 * Enhanced Split View component with intelligent text processing and PDF generation
 */
export default function EnhancedSplitView({ 
  leftContent, 
  rightContent, 
  title = "Execution Results",
  showPDFExport = true,
  splitRatio = 50 // Percentage for left panel (50 = equal split)
}) {
  const [isResizing, setIsResizing] = useState(false);
  const [currentSplitRatio, setCurrentSplitRatio] = useState(splitRatio);
  const [isDragging, setIsDragging] = useState(false);
  
  // Get user and execution data from Redux store
  const userData = useSelector(state => state.user || {});
  const executionData = useSelector(state => state.execution || {});

  // Handle mouse events for resizing
  const handleMouseDown = useCallback((e) => {
    e.preventDefault();
    setIsResizing(true);
    setIsDragging(true);
  }, []);

  const handleMouseMove = useCallback((e) => {
    if (!isResizing) return;
    
    const container = e.currentTarget.closest('.split-view-container');
    if (!container) return;
    
    const rect = container.getBoundingClientRect();
    const newRatio = ((e.clientX - rect.left) / rect.width) * 100;
    
    // Constrain between 20% and 80%
    const constrainedRatio = Math.max(20, Math.min(80, newRatio));
    setCurrentSplitRatio(constrainedRatio);
  }, [isResizing]);

  const handleMouseUp = useCallback(() => {
    setIsResizing(false);
    setIsDragging(false);
  }, []);

  // Add global mouse event listeners
  React.useEffect(() => {
    if (isResizing) {
      document.addEventListener('mousemove', handleMouseMove);
      document.addEventListener('mouseup', handleMouseUp);
      document.body.style.cursor = 'col-resize';
      document.body.style.userSelect = 'none';
      
      return () => {
        document.removeEventListener('mousemove', handleMouseMove);
        document.removeEventListener('mouseup', handleMouseUp);
        document.body.style.cursor = '';
        document.body.style.userSelect = '';
      };
    }
  }, [isResizing, handleMouseMove, handleMouseUp]);

  // Generate PDF data
  const pdfData = useMemo(() => ({
    title: title,
    user: userData,
    execution: executionData,
    leftContent: leftContent,
    rightContent: rightContent,
    timestamp: new Date().toISOString()
  }), [title, userData, executionData, leftContent, rightContent]);

  // Handle PDF export
  const handlePDFExport = useCallback(() => {
    const pdfGenerator = new PDFGenerator();
    pdfGenerator.generatePDFDocument(pdfData);
  }, [pdfData]);

  // Reset split to equal
  const resetSplit = useCallback(() => {
    setCurrentSplitRatio(50);
  }, []);

  // Render content with TextRenderer
  const renderContent = useCallback((content) => {
    if (React.isValidElement(content)) {
      return content;
    }
    
    if (typeof content === 'string') {
      return <TextRenderer rawText={content} className="split-view-text" />;
    }
    
    if (content && typeof content === 'object') {
      // Handle comparison responses
      if (content.actualResponse !== undefined || content.idealResponse !== undefined) {
        return (
          <EnhancedComparisonResponses
            actualResponse={content.actualResponse}
            idealResponse={content.idealResponse}
          />
        );
      }
      
      // Handle other object content
      return (
        <div className="split-view-object">
          <pre>{JSON.stringify(content, null, 2)}</pre>
        </div>
      );
    }
    
    return (
      <div className="split-view-empty">
        <div className="empty-content">
          No content available
        </div>
      </div>
    );
  }, []);

  return (
    <div className="enhanced-split-view">
      {/* Header */}
      <div className="split-view-header">
        <h3 className="split-view-title">{title}</h3>
        <div className="split-view-controls">
          <button 
            className="control-btn reset-btn"
            onClick={resetSplit}
            title="Reset to equal split"
          >
            ⚌
          </button>
          {showPDFExport && (
            <button 
              className="control-btn pdf-btn"
              onClick={handlePDFExport}
              title="Export to PDF"
            >
              📄
            </button>
          )}
        </div>
      </div>

      {/* Split View Container */}
      <div 
        className={`split-view-container ${isDragging ? 'dragging' : ''}`}
        onMouseMove={handleMouseMove}
      >
        {/* Left Panel */}
        <div 
          className="split-panel left-panel"
          style={{ width: `${currentSplitRatio}%` }}
        >
          <div className="panel-content">
            {renderContent(leftContent)}
          </div>
        </div>

        {/* Resizer */}
        <div 
          className={`split-resizer ${isResizing ? 'active' : ''}`}
          onMouseDown={handleMouseDown}
          role="separator"
          aria-orientation="vertical"
          aria-label="Resize panels"
          tabIndex={0}
          onKeyDown={(e) => {
            if (e.key === 'ArrowLeft') {
              setCurrentSplitRatio(Math.max(20, currentSplitRatio - 5));
            } else if (e.key === 'ArrowRight') {
              setCurrentSplitRatio(Math.min(80, currentSplitRatio + 5));
            } else if (e.key === 'Enter' || e.key === ' ') {
              resetSplit();
            }
          }}
        >
          <div className="resizer-handle">
            <div className="resizer-dots">
              <span></span>
              <span></span>
              <span></span>
            </div>
          </div>
        </div>

        {/* Right Panel */}
        <div 
          className="split-panel right-panel"
          style={{ width: `${100 - currentSplitRatio}%` }}
        >
          <div className="panel-content">
            {renderContent(rightContent)}
          </div>
        </div>
      </div>

      {/* Status Bar */}
      <div className="split-view-status">
        <span className="status-info">
          Split: {Math.round(currentSplitRatio)}% / {Math.round(100 - currentSplitRatio)}%
        </span>
        {showPDFExport && (
          <span className="status-info">
            Ready for PDF export
          </span>
        )}
      </div>
    </div>
  );
}

