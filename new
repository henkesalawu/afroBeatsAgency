import { marked } from 'marked';
import htmlToPdfmake from 'html-to-pdfmake';

/** Inserts zero-width spaces into long strings for wrapping */
function insertZeroWidthSpaces(text, maxLength = 20) {
  if (!text) return '';
  const regex = new RegExp(`(.{${maxLength}})`, 'g');
  return text.replace(regex, '$1\u200B');
}

/**
 * Tries to parse text as key-value pairs.
 * Returns array of {key, value} if >= threshold ratio of lines match, else null.
 */
function tryParseKeyValueText(text, threshold = 0.7) {
  if (!text) return null;
  const lines = text
    .split('\n')
    .map(line => line.trim())
    .filter(line => line.length > 0);

  const kvRegex = /^([\w\d_]+)\s+(.+)$/; // key value

  const kvPairs = [];
  let matchedLines = 0;

  for (const line of lines) {
    const match = line.match(kvRegex);
    if (match) {
      matchedLines++;
      kvPairs.push({ key: match[1], value: match[2] });
    } else {
      // Non-matching lines are appended to last pair's value (continuation)
      if (kvPairs.length) {
        kvPairs[kvPairs.length - 1].value += ' ' + line;
      } else {
        // No valid pairs at start: treat as unstructured
        return null;
      }
    }
  }

  if (lines.length === 0) return null;
  if (matchedLines / lines.length >= threshold) {
    return kvPairs;
  }
  return null;
}

/** Converts parsed key-value pairs to a pdfMake table */
function keyValuePairsToPdfMakeTable(pairs) {
  if (!pairs?.length) return [];

  const body = [
    [
      { text: 'Key', style: 'tableHeader' },
      { text: 'Value', style: 'tableHeader' },
    ],
    ...pairs.map(({ key, value }) => [
      { text: insertZeroWidthSpaces(key), style: 'kvKey' },
      { text: insertZeroWidthSpaces(value), style: 'kvValue' },
    ]),
  ];

  return [
    {
      style: 'kvTable',
      table: {
        headerRows: 1,
        widths: ['auto', '*'],
        body,
      },
      layout: 'lightHorizontalLines',
      margin: [0, 5, 0, 15],
    },
  ];
}

/** Converts markdown string to pdfMake content with zero-width space insertion */
const markdownToPdfMakeContent = (markdown) => {
  try {
    const processedMarkdown = insertZeroWidthSpaces(markdown || '', 20);
    const html = marked(processedMarkdown);
    const pdfmakeContent = htmlToPdfmake(html, { window: window });
    return Array.isArray(pdfmakeContent) ? pdfmakeContent : [pdfmakeContent];
  } catch (error) {
    console.error('Error converting markdown to pdfMake content:', error);
    return [
      { text: insertZeroWidthSpaces(markdown || '', 20), style: 'responseText' },
    ];
  }
};

/**
 * Tries to parse the text as JSON and returns pretty-printed string.
 * Returns null if not valid JSON.
 */
function tryParseAndPrettyPrintJSON(text) {
  if (!text) return null;
  try {
    const obj = JSON.parse(text);
    // Pretty print JSON with 2 spaces indentation
    return JSON.stringify(obj, null, 2);
  } catch {
    return null;
  }
}

/**
 * Unified formatter for text field:
 * - Detects JSON → pretty print in monospace style
 * - Uses key-value table if detected (unless skipKeyValue is true)
 * - Otherwise renders markdown content
 */
function formatTextForPdf(text, options = {}) {
  const { skipKeyValue = false } = options;

  const jsonPretty = tryParseAndPrettyPrintJSON(text);
  if (jsonPretty) {
    // Render JSON with monospace font and code style
    // Insert zero-width spaces to avoid overflow on long continuous strings
    const wrappedJson = insertZeroWidthSpaces(jsonPretty, 20);
    return [
      {
        text: wrappedJson,
        style: 'codeBlock', // monospace style defined in pdfMake styles
      },
    ];
  }

  if (!skipKeyValue) {
    const parsedPairs = tryParseKeyValueText(text);
    if (parsedPairs) {
      return keyValuePairsToPdfMakeTable(parsedPairs);
    }
  }

  return markdownToPdfMakeContent(text);
}

/**
 * Main function to generate pdfMake document definition from execution data.
 */
export function generatePDFDocument(execution) {
  const content = [];

  // Header
  content.push({ text: 'Execution Details', style: 'header' });

  // Execution Info Table
  const execInfoBody = [
    ['Field', 'Value'].map((txt) => ({ text: txt, style: 'tableHeader' })),
    ['Execution ID', execution.execution_id],
    ['Status', execution.status],
    ['Executed By', execution.executed_by],
    ['Model', execution.model],
    ['Dataset ID', execution.dataset_id],
    ['Aidlet ID', execution.aidlet_id],
    ['Started At', execution.started_at],
    ['Finished At', execution.finished_at || 'N/A'],
    ['Created At', execution.created_at],
  ];
  content.push({
    style: 'detailsTable',
    table: {
      widths: ['auto', '*'],
      body: execInfoBody,
    },
    layout: 'lightHorizontalLines',
    margin: [0, 0, 0, 15],
  });

  // Results Section
  content.push({ text: 'Results', style: 'header' });

  if (!execution.results || execution.results.length === 0) {
    content.push({ text: 'No results available.', italics: true, margin: [0, 0, 0, 15] });
  } else {
    execution.results.forEach((result, idx) => {
      content.push({ text: `Result ${idx + 1}`, style: 'subheader', margin: [0, 10, 0, 5] });

      // Prompt (always render as markdown/JSON, skip key-value table)
      content.push({
        columns: [
          { width: 'auto', text: 'Prompt:', bold: true },
          {
            width: '*',
            stack: formatTextForPdf(result.prompt_text || 'N/A', { skipKeyValue: true }),
            style: 'responseText',
            margin: [0, 5, 0, 5],
          },
        ],
      });

      // Status
      content.push({
        columns: [
          { width: 'auto', text: 'Status:', bold: true },
          { width: '*', text: result.status || 'N/A' },
        ],
        margin: [0, 2, 0, 2],
      });

      // Final Reason
      content.push({ text: 'Final Reason', style: 'smallHeader', margin: [0, 8, 0, 4] });
      content.push({ stack: formatTextForPdf(result.final_reason), style: 'responseText' });

      // Actual Response
      content.push({ text: 'Actual Response', style: 'smallHeader', margin: [0, 8, 0, 4] });
      content.push({ stack: formatTextForPdf(result.actual_response), style: 'responseText' });

      // Ideal Response (allow key-value table if detected)
      content.push({ text: 'Ideal Response', style: 'smallHeader', margin: [0, 8, 0, 4] });
      content.push({ stack: formatTextForPdf(result.ideal_response), style: 'responseText' });

      // Metrics Table
      content.push({ text: 'Metrics', style: 'smallHeader', margin: [0, 8, 0, 4] });

      if (result.metrics && result.metrics.length > 0) {
        const metricTableBody = [
          ['Metric', 'Score', 'Status', 'Reason'].map((header) => ({
            text: header,
            style: 'tableHeader',
          })),
          ...result.metrics.map((metric) => [
            execution.metricsLabels?.[metric.name] || metric.name,
            `${(metric.score * 100).toFixed(0)}%`,
            metric.status,
            metric.reason || '',
          ]),
        ];

        content.push({
          style: 'metricsTable',
          table: {
            headerRows: 1,
            widths: ['*', 'auto', 'auto', '*'],
            body: metricTableBody,
          },
          layout: {
            fillColor: (rowIndex) => (rowIndex % 2 === 0 ? '#f9f9f9' : null),
          },
          margin: [0, 0, 0, 10],
        });
      } else {
        content.push({
          text: 'No metrics available for this result.',
          italics: true,
          margin: [0, 0, 0, 10],
        });
      }

      // Page break between results except the last
      if (idx !== execution.results.length - 1) {
        content.push({ text: '', pageBreak: 'after' });
      }
    });
  }

  // Overall Metrics
  content.push({
    text: 'Overall Execution Metrics',
    style: 'header',
    margin: [0, 10, 0, 5],
  });

  if (execution.metrics && execution.metrics.length > 0) {
    const overallMetricTableBody = [
      ['Metric', 'Score', 'Status', 'Reason'].map((header) => ({
        text: header,
        style: 'tableHeader',
      })),
      ...execution.metrics.map((metric) => [
        execution.metricsLabels?.[metric.name] || metric.name,
        `${(metric.score * 100).toFixed(0)}%`,
        metric.status,
        metric.reason || '',
      ]),
    ];

    content.push({
      style: 'metricsTable',
      table: {
        headerRows: 1,
        widths: ['*', 'auto', 'auto', '*'],
        body: overallMetricTableBody,
      },
      layout: {
        fillColor: (rowIndex) => (rowIndex % 2 === 0 ? '#f9f9f9' : null),
      },
      margin: [0, 0, 0, 10],
    });
  } else {
    content.push({ text: 'No overall metrics available.', italics: true });
  }

  // Document definition with styles
  const docDefinition = {
    content,
    styles: {
      header: { fontSize: 20, bold: true, color: '#42145F', margin: [0, 10, 0, 10] },          // zb-purple
      subheader: { fontSize: 16, bold: true, margin: [0, 10, 0, 5], color: '#5A287D' },        // zb-world1
      smallHeader: { fontSize: 14, bold: true, margin: [0, 8, 0, 3], color: '#5E10B1' },      // zb-bright-purple
      tableHeader: { bold: true, fillColor: '#5A287D', color: '#fff', margin: [0, 5, 0, 5] },  // zb-world1 bg with white text
      detailsTable: { margin: [0, 0, 0, 15], fontSize: 11, color: '#42145F' },                  // zb-purple text
      metricsTable: { margin: [0, 5, 0, 15], fontSize: 11, color: '#42145F' },                  // zb-purple text
      responseText: { fontSize: 11, margin: [0, 5, 0, 10], color: '#5E10B1' },                  // zb-bright-purple
      paragraph: { margin: [0, 5, 0, 5], fontSize: 11, color: '#42145F' },                      // zb-purple
      listItem: { fontSize: 11, margin: [0, 0, 0, 2], color: '#42145F' },                      // zb-purple
      blockquote: {
        margin: [10, 5, 0, 10],
        italics: true,
        color: '#5A287D',    // zb-world1
        borderColor: '#A58CC3', // zb-world2 lighter border
        borderLeft: 3,
        paddingLeft: 10,
      },
      codeBlock: {
        fontSize: 10,
        fontFamily: 'monospace',
        background: '#EBA5AA',  // zb-rose-light background for code, soft rose
        margin: [0, 5, 0, 5],
        padding: 5,
        color: '#42145F', // zb-purple text
        whiteSpace: 'pre-wrap', // preserve whitespace for JSON display
      },
      strong: { bold: true, color: '#5E10B1' }, // zb-bright-purple for strong text
      em: { italics: true, color: '#5A287D' },  // zb-world1 purple for emphasis

      // Key-value table styles
      kvTable: { margin: [0, 5, 0, 15], fontSize: 11, color: '#42145F' },   // zb-purple
      kvKey: { bold: true, color: '#42145F', margin: [0, 2, 0, 2] },        // zb-purple bold keys
      kvValue: { margin: [0, 2, 0, 2], color: '#5E10B1' },                  // zb-bright-purple values
    },
    defaultStyle: {
      font: 'Roboto',
      fontSize: 11,
      lineHeight: 1.2,
      color: '#42145F',  // zb-purple default text color
    },
    pageMargins: [40, 60, 40, 60],
  };

  return docDefinition;
}
