import React, { useState, useCallback } from 'react';
import TextRenderer from './TextProcessor';
import './EnhancedComparisonResponses.css';

const MAX_CHAR_LIMIT = 600; // Increased for better readability

/**
 * Enhanced ComparisonResponses component with intelligent text processing
 */
export default function EnhancedComparisonResponses({ actualResponse, idealResponse }) {
  const [expanded, setExpanded] = useState({
    actual: false,
    ideal: false,
  });

  const toggleExpand = useCallback((key) => {
    setExpanded((prev) => ({ ...prev, [key]: !prev[key] }));
  }, []);

  // Convert input to safe string
  const toSafeString = (input) => (typeof input === 'string' ? input : '');

  // Check if content is long enough to need expansion
  const isLongContent = (text) => text.length > MAX_CHAR_LIMIT;

  // Render one response column with expand/collapse functionality
  const renderResponseColumn = (textInput, key, title) => {
    const text = toSafeString(textInput);
    const isLong = isLongContent(text);
    const isExpanded = expanded[key];

    if (!text.trim()) {
      return (
        <div className="response-column">
          <h5 className="response-column-header">{title}</h5>
          <div className="response-column-content empty">
            <div className="no-content">
              No {title.toLowerCase()} available
            </div>
          </div>
        </div>
      );
    }

    return (
      <div className="response-column">
        <h5 className="response-column-header">{title}</h5>
        <div 
          className={`response-column-content ${isLong ? 'expandable' : ''}`}
          onClick={() => isLong && toggleExpand(key)}
          style={{ cursor: isLong ? 'pointer' : 'default' }}
          title={isLong ? (isExpanded ? 'Click to collapse' : 'Click to expand') : ''}
          tabIndex={isLong ? 0 : undefined}
          onKeyDown={(e) => {
            if ((e.key === 'Enter' || e.key === ' ') && isLong) {
              e.preventDefault();
              toggleExpand(key);
            }
          }}
          role={isLong ? 'button' : undefined}
          aria-expanded={isExpanded}
          aria-label={`${title} content`}
        >
          <TextRenderer 
            rawText={isExpanded || !isLong ? text : text} 
            maxLength={isExpanded || !isLong ? null : MAX_CHAR_LIMIT}
            className="response-text"
          />
          
          {isLong && (
            <div className="expand-indicator">
              <button 
                className="expand-toggle-btn"
                onClick={(e) => {
                  e.stopPropagation();
                  toggleExpand(key);
                }}
              >
                {isExpanded ? 'Show Less' : 'Show More'}
              </button>
            </div>
          )}
        </div>
      </div>
    );
  };

  return (
    <div className="comparison-responses">
      <div className="responses-container">
        {renderResponseColumn(actualResponse, 'actual', 'Actual Response')}
        {renderResponseColumn(idealResponse, 'ideal', 'Expected Response')}
      </div>
    </div>
  );
}

